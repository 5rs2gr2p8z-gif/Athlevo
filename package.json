{
  "name": "athlevo",
  "version": "0.6.0",
  "private": true,
  "type": "module",
  "description": "Athlevo web application and Capacitor iOS shell",
  "scripts": {
    "build:native": "node scripts/build-native-web.mjs",
    "ios:prepare": "npm run build:native && cap sync ios",
    "ios:open": "npm run ios:prepare && cap open ios",
    "ios:run": "npm run ios:prepare && cap run ios",
    "test:native": "node tests/native-ios-runtime.test.mjs"
  },
  "dependencies": {
    "@capacitor/app": "8.1.1",
    "@capacitor/browser": "8.0.4",
    "@capacitor/core": "8.4.2",
    "@capacitor/keyboard": "8.0.5",
    "@capacitor/network": "8.0.1",
    "@capacitor/splash-screen": "8.0.2",
    "@capacitor/status-bar": "8.0.3",
    "@supabase/supabase-js": "2.111.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.4.2",
    "@capacitor/ios": "8.4.2"
  }
}
